# Ponder environment defaults (copy to .env — all values optional)
# Server port
PORT=8787
# SQLite file location (relative to server/)
DB_PATH=./data/app.db

# Prefer adding your key in Settings → AI & connections; changes apply instantly.
# This optional environment key is used when Settings has no key override.
# Get a key at https://openrouter.ai/keys (free text models; pictures use credits).
OPENROUTER_API_KEY=

# On-demand Picture action: image models use OpenRouter credits (separate from
# the free text models). Settings can override this default without a restart.
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# Ollama endpoint
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional model overrides (must exist locally in `ollama list`). Leave these
# unset to choose models in Settings. Defaults are shown; uncomment to override.
# CANVAS_FAST_MODEL=llama3.2:3b
# CANVAS_QUALITY_MODEL=gemma3:4b

# Prefer free OpenRouter text models when a key is set (default true).
# Settings can override this. Failures fall back to the local Ollama models.
CANVAS_PREFER_OPENROUTER=true

# Optional scheduled local snapshots (disabled unless positive; hours).
# Backups include saved API keys. Default location: server/backups/.
# CANVAS_BACKUP_EVERY_HOURS=24
