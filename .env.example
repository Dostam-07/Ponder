# Canvas Learn environment (copy to .env — all values optional)
# Server port
PORT=8787
# SQLite file location (relative to server/)
DB_PATH=./data/app.db

# OpenRouter API key (optional). Without it, the app uses local Ollama only.
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Ollama endpoint
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Model overrides (must exist locally in `ollama list`)
CANVAS_FAST_MODEL=qwen2.5:7b
CANVAS_QUALITY_MODEL=qwen2.5:14b-instruct-q4_K_M

# Prefer OpenRouter free models for every stage when a key is set (default true).
# Any failure/rate-limit silently falls back to the local Ollama models above.
CANVAS_PREFER_OPENROUTER=true
